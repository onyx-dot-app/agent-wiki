# --- Backend ---
FLASK_ENV=development
SECRET_KEY=change-me

# Where the wiki git repo lives inside the backend container.
WIKI_DIR=/data/wiki
APP_DB_PATH=/data/app.sqlite
QUEUE_DB_PATH=/data/queue.sqlite

# --- Auth ---
# basic | oidc
AUTH_MODE=basic

# Comma-separated email whitelist for signup. Empty = anyone can sign up.
# Domain wildcards allowed: ALLOWED_EMAILS=*@onyx.app,specific@example.com
ALLOWED_EMAILS=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- LLM ---
# Provider, model, and API keys are configured at runtime via the admin page
# (Admin → LLM tab). They are stored in the app database, not in env vars.

# --- Frontend ---
NEXT_PUBLIC_API_BASE=/api

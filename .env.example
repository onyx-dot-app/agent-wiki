# --- Backend ---
FLASK_ENV=development
SECRET_KEY=change-me

# Where the wiki git repo lives inside the backend container.
WIKI_DIR=/data/wiki
APP_DB_PATH=/data/app.sqlite
QUEUE_DB_PATH=/data/queue.sqlite

# --- Auth ---
# basic | oidc
AUTH_MODE=basic
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- LLM ---
# Provider for the agent harness. anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-opus-4-7

# --- Frontend ---
NEXT_PUBLIC_API_BASE=/api

# --- Backend ---
FLASK_ENV=development
SECRET_KEY=change-me

# Where the wiki git repo lives. Relative paths are resolved against the
# repo root (see `app/config.py`), so this works regardless of the launch
# cwd. Compose overrides this to `/data/wiki` for in-container runs.
WIKI_DIR=./local_data/wiki

# App state + task queues live in the same Postgres (pgmq for the queues).
# This URL is for **host** runs — the compose Postgres service publishes
# 5432 to 127.0.0.1, and `postgres`/`postgres` are the credentials it boots
# with. Inside compose containers the `environment:` block overrides
# DATABASE_URL to use the internal hostname `postgres`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_wiki

# Per-queue max backlog. New enqueues fail fast with a 503 when a queue is
# at this size. Default 1000; applies to all three pgmq queues.
MAX_QUEUE_SIZE=1000

# --- Auth ---
# basic | oidc
AUTH_MODE=basic

# Comma-separated email whitelist for signup. Empty = anyone can sign up.
# Domain wildcards allowed: ALLOWED_EMAILS=*@onyx.app,specific@example.com
ALLOWED_EMAILS=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- LLM ---
# Provider, model, and API keys are configured at runtime via the admin page
# (Admin → LLM tab). They are stored in the app database, not in env vars.

# --- Frontend ---
NEXT_PUBLIC_API_BASE=/api
